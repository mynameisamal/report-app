// ============================================================
// TaskMaster PEI - Database Schema (Prisma + PostgreSQL)
// Target: Neon.tech Serverless PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  DIREKTUR
  KOORDINATOR
  TEKNISI
  LEAD_IT
  IT_PROGRAMMER
  LEAD_AI
  AI_ENGINEER

  @@map("role_enum")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  ACCEPTED
  COMPLETED
  REJECTED

  @@map("task_status_enum")
}

enum Department {
  IT
  AI
  TEKNISI

  @@map("department_enum")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REVIEW
  TASK_APPROVED
  TASK_REJECTED
  REPORT_GENERATED
  SYSTEM

  @@map("notification_type_enum")
}

// ============================================================
// MODELS
// ============================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(100)
  email        String?  @unique @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(TEKNISI)
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  assignedTasks    Task[]            @relation("assigned_tasks")
  createdTasks     Task[]            @relation("created_tasks")
  ledProjects      Project[]         @relation("led_projects")
  dailyReports     DailyReport[]
  notifications    Notification[]

  @@map("users")
}

model Project {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(255)
  description String?    @db.Text
  leadId      String?    @map("lead_id") @db.Uuid
  lead        User?      @relation("led_projects", fields: [leadId], references: [id])
  department  Department
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  tasks Task[]

  @@map("projects")
}

model Task {
  id           String     @id @default(uuid()) @db.Uuid
  title        String     @db.VarChar(255)
  description  String?    @db.Text
  instructions String?    @db.Text
  githubLink   String?    @map("github_link")
  status       TaskStatus @default(PENDING)
  assignedTo   String?    @map("assigned_to") @db.Uuid
  assignee     User?      @relation("assigned_tasks", fields: [assignedTo], references: [id])
  createdBy    String     @map("created_by") @db.Uuid
  creator      User       @relation("created_tasks", fields: [createdBy], references: [id])
  projectId    String?    @map("project_id") @db.Uuid
  project      Project?   @relation(fields: [projectId], references: [id])
  targetDate   DateTime?  @map("target_date") @db.Timestamptz
  completedAt  DateTime?  @map("completed_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([assignedTo])
  @@index([createdBy])
  @@index([status])
  @@index([projectId])
  @@map("tasks")
}

model DailyReport {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  date            DateTime @db.Date
  content         String   @db.Text
  tasksCompleted  Int      @default(0) @map("tasks_completed")
  tasksInProgress Int      @default(0) @map("tasks_in_progress")
  tasksPending    Int      @default(0) @map("tasks_pending")
  isAuto          Boolean  @default(false) @map("is_auto")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("daily_reports")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String?          @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
